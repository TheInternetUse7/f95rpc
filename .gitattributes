# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Go source code and config files
*.go text eol=lf
*.mod text eol=lf
*.sum text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf

# Windows scripts must keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.icns binary
*.avif binary
*.db binary
*.sqlite binary
*.sqlite3 binary
